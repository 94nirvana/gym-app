<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_main">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Evolução &amp; Histórico"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnToggleMetric"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Métrica: Volume (kg)"
            android:textSize="11sp"
            android:textColor="@color/accent"
            app:backgroundTint="@color/accent_subtle" />
    </LinearLayout>

    <!-- Gráfico Minimalista de Progressão de Carga -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp"
        app:cardCornerRadius="10dp">

        <com.gymapp.minimalist.ui.ProgressChartView
            android:id="@+id/chartProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Treinos Concluídos"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- Lista de Sessões Anteriores -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorySessions"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scrollbars="vertical" />

    <!-- Ações Inferiores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnClearHistory"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Limpar"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnCloseHistory"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Fechar"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/bg_card_elevated" />
    </LinearLayout>

</LinearLayout>
