<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- App Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/layoutWorkoutTitleHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GymTrack"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/tvCurrentWorkoutSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treino A ✎"
                        android:textSize="13sp"
                        android:textColor="@color/accent" />
                </LinearLayout>

                <!-- Botão Histórico -->
                <ImageButton
                    android:id="@+id/btnOpenHistory"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Histórico e Progresso"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/text_primary"
                    android:layout_marginEnd="4dp" />

                <!-- Botão Backup -->
                <ImageButton
                    android:id="@+id/btnOpenBackup"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Backup Local"
                    android:src="@android:drawable/ic_menu_save"
                    app:tint="@color/text_primary"
                    android:layout_marginEnd="6dp" />

                <!-- Botão Adicionar Exercício -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddExercise"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="+ Adicionar"
                    android:textSize="12sp"
                    android:textColor="@color/accent_text"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Workout Selector (A, B, C, D, E) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupWorkouts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWorkoutA"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treino A"
                        android:checked="true"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_card" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWorkoutB"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treino B"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_card" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWorkoutC"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treino C"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_card" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWorkoutD"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treino D"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_card" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWorkoutE"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treino E"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_card" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Ações do Treino Atual: Concluir Treino & Resetar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompleteWorkout"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="✓ Concluir Treino"
                    android:textSize="12sp"
                    android:textColor="@color/accent_text"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetWorkout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Resetar"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    app:strokeColor="@color/border_subtle"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Rest Timer Card (Minimalist) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Descanso Entre Séries"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvTimerDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="01:00"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Timer Presets -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <Button
                            android:id="@+id/btnPreset30"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:padding="0dp"
                            android:text="30s"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_card_elevated" />

                        <Button
                            android:id="@+id/btnPreset45"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:padding="0dp"
                            android:text="45s"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_card_elevated" />

                        <Button
                            android:id="@+id/btnPreset60"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:padding="0dp"
                            android:text="60s"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_card_elevated" />

                        <Button
                            android:id="@+id/btnPreset90"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:padding="0dp"
                            android:text="90s"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_card_elevated" />

                        <Button
                            android:id="@+id/btnPreset120"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:padding="0dp"
                            android:text="2m"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_card_elevated" />
                    </LinearLayout>

                    <!-- Timer Controls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnStartTimer"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Iniciar"
                            android:textSize="13sp"
                            android:textColor="@color/accent_text"
                            app:backgroundTint="@color/accent"
                            app:cornerRadius="8dp" />

                        <Button
                            android:id="@+id/btnResetTimer"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Reset"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            app:strokeColor="@color/border_subtle"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Exercise List Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Exercícios"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Segure para reordenar"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_workout_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_workout_desc"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Exercises RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_exercise" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
